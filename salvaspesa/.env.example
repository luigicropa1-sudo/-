# Copia questo file come .env e compila i valori (il file .env non va mai pubblicato).

# Password del pannello di gestione (indirizzo /admin)
ADMIN_PASSWORD=

# Facoltativo: avviso su Telegram per ogni nuovo ordine
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facoltativo: cartella dove salvare gli ordini (su Render: il percorso del disco persistente)
DATA_DIR=

# Porta locale (le piattaforme di hosting la impostano da sole)
PORT=3000
