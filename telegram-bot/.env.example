# Copia questo file come .env e compila i valori (il file .env non va mai pubblicato).

# Token del bot: lo dà @BotFather quando crei il bot
BOT_TOKEN=

# Indirizzo pubblico https dove gira questo server, es. https://mio-negozio.onrender.com
PUBLIC_URL=

# Chat dove arrivano gli ordini (la tua chat privata con il bot o un gruppo).
# Per saperlo scrivi /id al bot, oppure nel gruppo dopo averci aggiunto il bot.
ADMIN_CHAT_ID=

# Porta locale (le piattaforme di hosting la impostano da sole)
PORT=3000
